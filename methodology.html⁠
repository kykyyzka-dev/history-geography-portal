<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Методична скарбничка — Історія і географія БЕЗ МЕЖ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css?v=5">
  <style>
    .resource-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 25px; margin-bottom: 35px; }
    .resource-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 25px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; justify-content: space-between; }
    .resource-card:hover { transform: translateY(-3px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
    .resource-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; }
    .resource-icon { font-size: 32px; background: #eff6ff; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
    .resource-title { font-size: 18px; font-weight: 700; color: #1e293b; }
    .resource-category { font-size: 11px; text-transform: uppercase; font-weight: 700; padding: 3px 8px; border-radius: 4px; display: inline-block; margin-bottom: 5px; }
    .cat-gamification { background: #dbeafe; color: #1e40af; }
    .cat-maps { background: #dcfce7; color: #166534; }
    .cat-nmt { background: #fef3c7; color: #92400e; }
    .cat-feedback { background: #f3e8ff; color: #6b21a8; }
    .resource-desc { font-size: 13px; color: #475569; line-height: 1.6; margin-bottom: 20px; flex-grow: 1; }
    .btn-resource { display: inline-block; text-align: center; background: #2563eb; color: white; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; transition: background 0.2s; }
    .btn-resource:hover { background: #1d4ed8; }
    .export-container { text-align: center; background: #eff6ff; border: 2px dashed #2563eb; padding: 20px; border-radius: 12px; margin: 30px 0; }
    .btn-export { background: #059669; color: white; border: none; padding: 14px 28px; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: background 0.2s; }
    .btn-export:hover { background: #047857; }
    .search-filter-box { margin: 25px 0; text-align: center; }
    .search-input { width: 100%; max-width: 500px; padding: 12px 20px; font-size: 15px; border: 2px solid #cbd5e1; border-radius: 8px; outline: none; transition: border-color 0.2s; }
    .search-input:focus { border-color: #2563eb; }
  </style>
</head>
<body>

  <!-- Навігаційна шапка -->
  <header>
    <a href="index.html" class="logo-group">
      <img src="logo.png" alt="Логотип Освітній Портал" class="logo-img">
      <div class="logo-text">Історія і географія<span>БЕЗ МЕЖ</span></div>
    </a>
    <nav>
      <ul>
        <li><a href="index.html">Головна</a></li>
        <li><a href="history.html">Історія</a></li>
        <li><a href="geography.html">Географія</a></li>
        <li><a href="nmt.html">НМТ</a></li>
        <li><a href="methodology.html">Методична скарбничка</a></li>
      </ul>
    </nav>
  </header>

  <!-- Банер сторінки -->
  <section class="hero-banner" style="background: linear-gradient(180deg, #059669 0%, #047857 60%, #1e293b 100%);">
    <div class="hero-text">
      <h1>МЕТОДИЧНА <span>СКАРБНИЧКА</span></h1>
      <p class="subtitle">Найкращі цифрові сервіси, платформи гейміфікації та офіційні ресурси для сучасних уроків</p>
      <p class="quote">“Інструменти, які роблять історію та географію захопливими й ефективними!”</p>
    </div>
    <div class="hero-author">
      <img src="author-photo.jpeg" alt="Сергій Мовчан">
    </div>
  </section>

  <!-- Основний контент -->
  <main class="main-container">

    <!-- КНОПКА ЕКСПОРТУ -->
    <div class="export-container">
      <h3 style="color: #1e293b; margin-bottom: 8px;">📥 Збереження методичних матеріалів</h3>
      <p style="font-size: 13px; color: #475569; margin-bottom: 15px;">Завантажте цю сторінку зі списком корисних ресурсів на свій пристрій:</p>
      <button class="btn-export" onclick="downloadFullPage()">💾 Зберегти скарбничку собі</button>
    </div>

    <!-- Пошук по ресурсах -->
    <div class="search-filter-box">
      <input type="text" id="resourceSearch" class="search-input" placeholder="🔍 Пошук сервісу за назвою або ключовим словом..." onkeyup="filterResources()">
    </div>

    <div class="section-title">🚀 Інтерактивні платформи та гейміфікація</div>
    
    <div class="resource-grid" id="resourceGrid">

      <!-- Wordwall -->
      <div class="resource-card" data-name="wordwall вордвол вправи тести">
        <div>
          <span class="resource-category cat-gamification">Гейміфікація</span>
          <div class="resource-header">
            <div class="resource-icon">🧩</div>
            <div class="resource-title">Wordwall</div>
          </div>
          <div class="resource-desc">
            Незамінний сервіс для створення інтерактивних ігор, кросвордів, знаходження пар, сортування історичних подій за хронологією та робота з контурними картами. Ідеально для швидкого опрацювання термінів.
          </div>
        </div>
        <a href="https://wordwall.net/uk" target="_blank" class="btn-resource">Відкрити Wordwall</a>
      </div>

      <!-- Kahoot! -->
      <div class="resource-card" data-name="kahoot кахут квіз змагання тест">
        <div>
          <span class="resource-category cat-gamification">Гейміфікація</span>
          <div class="resource-header">
            <div class="resource-icon">🎮</div>
            <div class="resource-title">Kahoot!</div>
          </div>
          <div class="resource-desc">
            Платформа для проведення динамічних командних або індивідуальних квізів у режимі реального часу. Чудово підходить для перевірки знань дат, персоналій та пам'яток на уроці зі смартфонів учнів.
          </div>
        </div>
        <a href="https://kahoot.com/" target="_blank" class="btn-resource">Відкрити Kahoot!</a>
      </div>

      <!-- Quizizz -->
      <div class="resource-card" data-name="quizizz квізіз тест домашнє завдання">
        <div>
          <span class="resource-category cat-gamification">Гейміфікація</span>
          <div class="resource-header">
            <div class="resource-icon">⚡</div>
            <div class="resource-title">Quizizz</div>
          </div>
          <div class="resource-desc">
            Альтернатива Kahoot із можливістю проходити тести в індивідуальному темпі. Має велику базу готових тестів до НМТ з історії України та географії з детальною аналітикою помилок.
          </div>
        </div>
        <a href="https://quizizz.com/" target="_blank" class="btn-resource">Відкрити Quizizz</a>
      </div>

      <!-- LearningApps -->
      <div class="resource-card" data-name="learningapps лернінг аппс вправи завдання">
        <div>
          <span class="resource-category cat-gamification">Гейміфікація</span>
          <div class="resource-header">
            <div class="resource-icon">📚</div>
            <div class="resource-title">LearningApps.org</div>
          </div>
          <div class="resource-desc">
            Величезний каталог готових інтерактивних вправ, створених вчителями-практиками. Зручний конструктор для створення власних навчальних завдань за кілька хвилин.
          </div>
        </div>
        <a href="https://learningapps.org/" target="_blank" class="btn-resource">Відкрити LearningApps</a>
      </div>

      <!-- Google Earth -->
      <div class="resource-card" data-name="google earth планета земля географія карти 3d">
        <div>
          <span class="resource-category cat-maps">Картографія та Візуалізація</span>
          <div class="resource-header">
            <div class="resource-icon">🌍</div>
            <div class="resource-title">Google Earth</div>
          </div>
          <div class="resource-desc">
            Потужний інструмент для віртуальних подорожей на уроках географії. Дозволяє вивчати рельєф, тектонічні плити, річки та об'єкти Світової спадщини ЮНЕСКО у форматі 3D.
          </div>
        </div>
        <a href="https://earth.google.com/" target="_blank" class="btn-resource">Відкрити Google Earth</a>
      </div>

      <!-- MapChart -->
      <div class="resource-card" data-name="mapchart карти історія географія створення контурних карт">
        <div>
          <span class="resource-category cat-maps">Картографія та Візуалізація</span>
          <div class="resource-header">
            <div class="resource-icon">🗺️</div>
            <div class="resource-title">MapChart</div>
          </div>
          <div class="resource-desc">
            Зручний сервіс для створення власних історичних та географічних карт. Допомагає візуалізувати зміни кордонів держав, маршрути видатних мандрівників або економічні показники країн.
          </div>
        </div>
        <a href="https://mapchart.net/" target="_blank" class="btn-resource">Відкрити MapChart</a>
      </div>

      <!-- УЦОЯО -->
      <div class="resource-card" data-name="уцояо нмт зно офіційні тести підготовка">
        <div>
          <span class="resource-category cat-nmt">Підготовка до НМТ</span>
          <div class="resource-header">
            <div class="resource-icon">📋</div>
            <div class="resource-title">УЦОЯО (Офіційний сайт)</div>
          </div>
          <div class="resource-desc">
            Головне джерело достовірної інформації про тести НМТ: демонстраційні варіанти, програми предметів, характеристики завдань та офіційні графіки проведення іспитів.
          </div>
        </div>
        <a href="https://testportal.gov.ua/" target="_blank" class="btn-resource">Відкрити УЦОЯО</a>
      </div>

      <!-- Освіта.ua -->
      <div class="resource-card" data-name="освіта юа зно освіта тести тренажер">
        <div>
          <span class="resource-category cat-nmt">Підготовка до НМТ</span>
          <div class="resource-header">
            <div class="resource-icon">💻</div>
            <div class="resource-title">Освіта.ua (ЗНО-Онлайн)</div>
          </div>
          <div class="resource-desc">
            Найбільший архів тестів ЗНО та НМТ минулих років із можливістю проходження в режимі онлайн-тренажера з поясненнями до кожної правильної відповіді.
          </div>
        </div>
        <a href="https://zno.osvita.ua/" target="_blank" class="btn-resource">Відкрити Освіта.ua</a>
      </div>

      <!-- Padlet -->
      <div class="resource-card" data-name="padlet падлет дошка рефлексія зворотний зв'язок">
        <div>
          <span class="resource-category cat-feedback">Зворотний зв'язок</span>
          <div class="resource-header">
            <div class="resource-icon">📌</div>
            <div class="resource-title">Padlet</div>
          </div>
          <div class="resource-desc">
            Віртуальна інтерактивна дошка для спільної роботи учнів. Чудово підходить для етапу рефлексії наприкінці уроку, створення проектів або збору ідей під час групової роботи.
          </div>
        </div>
        <a href="https://padlet.com/" target="_blank" class="btn-resource">Відкрити Padlet</a>
      </div>

    </div>

  </main>

  <!-- Скрипти -->
  <script>
    // Функція пошуку/фільтрації ресурсів
    function filterResources() {
      const input = document.getElementById('resourceSearch').value.toLowerCase();
      const cards = document.querySelectorAll('.resource-card');

      cards.forEach(card => {
        const keywords = card.getAttribute('data-name').toLowerCase();
        if (keywords.includes(input)) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    }

    // Функція збереження сторінки
    function downloadFullPage() {
      const cloneDoc = document.documentElement.cloneNode(true);
      const exportBox = cloneDoc.querySelector('.export-container');
      if (exportBox) exportBox.remove();

      const fullHTML = "<!DOCTYPE html>\n" + cloneDoc.outerHTML;
      const blob = new Blob([fullHTML], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      
      const a = document.createElement('a');
      a.href = url;
      a.download = 'methodology_hub.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  </script>

</body>
</html>
